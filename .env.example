# GB Grid settings. Copy this file to .env next to docker-compose.yml.
# Every line is optional: delete one to use its default. Recreate the
# container (docker compose up -d) for changes to apply.

# Port on the host for the dashboard: http://<host>:GRID_PORT
GRID_PORT=8080

# Time zone for log timestamps. The pages always show UK time.
TZ=Europe/London

# Regional carbon intensity, shown as a toggle next to Great Britain on the
# overview. 0 turns it off. NESO's regions:
#  1 North Scotland       2 South Scotland        3 North West England
#  4 North East England   5 Yorkshire             6 North Wales and Merseyside
#  7 South Wales          8 West Midlands         9 East Midlands
# 10 East England        11 South West England   12 South England
# 13 London              14 South East England   15 England
# 16 Scotland            17 Wales
CARBON_REGION_ID=0

# Days of history to download on first start and keep (2 to 60).
# 30 or more adds a 30-day chart; the first start then takes a couple of minutes.
HISTORY_DAYS=7

# How often each open browser asks the server for new data, in seconds.
# It's answered from memory (usually with a 304), so it's cheap.
BROWSER_REFRESH_SECONDS=10

# How often the server polls each source, in seconds. The defaults poll a
# little faster than each source publishes, so new data appears within about
# a minute of release without hammering the free public APIs.
# Elexon generation by fuel type: new 5-minute data, usually a few minutes late.
POLL_GENERATION_SECONDS=60
# Elexon system frequency: readings 15 seconds apart.
POLL_FREQUENCY_SECONDS=20
# NESO Carbon Intensity API: half-hourly actuals and a 48-hour forecast.
POLL_CARBON_SECONDS=300
# Elexon market index price: half-hourly.
POLL_PRICE_SECONDS=300
# Sheffield Solar PV_Live: half-hourly, revised for three hours afterwards.
POLL_SOLAR_SECONDS=300
# NESO embedded wind and solar forecast: updated hourly.
POLL_EMBEDDED_SECONDS=1800
# NESO Demand Data Update (embedded history): updated daily.
POLL_DEMAND_UPDATE_SECONDS=3600
# Power station map: Elexon Bid-Offer Acceptances (the grid operator's
# instructions) are checked this often; unit schedules are fetched once per
# half hour and the BM unit register once a day.
POLL_UNITS_SECONDS=60

# INFO is quiet (errors, recoveries, backfill). DEBUG shows every poll.
LOG_LEVEL=INFO
# Log every HTTP request to the dashboard.
ACCESS_LOG=false
